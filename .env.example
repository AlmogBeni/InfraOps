# InfraOps production configuration template.
# Copy to .env, set every required value, then restrict it: chmod 600 .env

# Application
ENVIRONMENT=production
SECRET_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL. URL-encode reserved characters in database URL credentials.
# POSTGRES_USER owns the schema and is used only by the one-shot `migrate`
# service (MIGRATION_DATABASE_URL). The API and worker connect as a separate
# runtime role (DATABASE_URL) that `migrate` creates with least-privilege
# grants: it cannot alter tables, drop the audit trigger, or UPDATE/DELETE/
# TRUNCATE audit_events. Use a different, strong password for each role.
POSTGRES_USER=infraops
POSTGRES_PASSWORD=
POSTGRES_DB=infraops
MIGRATION_DATABASE_URL=postgresql+asyncpg://infraops:URL_ENCODED_OWNER_PASSWORD@postgres:5432/infraops
DATABASE_URL=postgresql+asyncpg://infraops_app:URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/infraops

# Redis is reachable only on the private Compose network.
REDIS_URL=redis://redis:6379/0

# Real integrations only in production.
INFRASTRUCTURE_MODE=real
# PEM bundle that signs the vCenter certificate (VMCA root, or your enterprise
# CA), as seen inside the backend/worker containers. Place the file in ./certs
# on the host (mounted read-only at /etc/infraops/certs). Leave empty when the
# vCenter certificate chains to a publicly trusted CA. Production refuses
# connections with TLS verification disabled.
# VCENTER_CA_DIR=./certs
VCENTER_CA_FILE=
# e.g. VCENTER_CA_FILE=/etc/infraops/certs/vcenter-ca.pem
AUTH_MODE=local
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=720
RATE_LIMIT_LOGIN_PER_MINUTE=10
COOKIE_SECURE=true

# vCenter, Windows administrator, and domain-join credentials are entered in
# Administration -> Credentials and encrypted in PostgreSQL. They do not
# belong in this file. CREDENTIAL_ENCRYPTION_KEY is the credential-encryption
# root key (at least 32 characters). When empty, SECRET_KEY is used, as in
# earlier releases. To rotate: set the new key, list the old root in
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS, run `python -m app.secrets.rotate`,
# then clear CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS. Back the key up securely.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

WORKER_CONCURRENCY=2
# RUNNING jobs whose worker stops heartbeating for this long become INTERRUPTED
# (retryable). Worker metrics/health are served on WORKER_METRICS_PORT.
WORKER_HEARTBEAT_TIMEOUT_SECONDS=120
WORKER_SHUTDOWN_GRACE_SECONDS=60
WORKER_METRICS_PORT=9102

# Leave empty for a same-origin reverse-proxy deployment. Otherwise list only
# the exact HTTPS browser origins, separated by commas.
CORS_ORIGINS=

# Used only when the database has no active administrator. Remove the password
# from .env after the first successful bootstrap and restart the services.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# The frontend is intentionally published on loopback for a host TLS reverse
# proxy. Change the bind address only if another firewall-protected design is used.
# TRUSTED_PROXY_CIDR is that proxy's address as seen from the frontend container
# (usually the Docker bridge gateway); only it may set X-Forwarded-For/-Proto.
# Narrow it to the exact gateway address (e.g. 172.18.0.1/32) when known.
TRUSTED_PROXY_CIDR=172.16.0.0/12
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
VITE_API_BASE=/api/v1
VITE_ENVIRONMENT_LABEL=PROD
