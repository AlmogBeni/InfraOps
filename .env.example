# ============================================================================
# InfraOps — Internal IT Infrastructure Automation Platform
# Copy this file to `.env` and adjust values. NEVER commit real `.env` files.
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development                      # development | production
SECRET_KEY=dev-only-secret-key-change-me-in-production
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                              # json | console

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Inside docker-compose the host is `postgres`; locally use `localhost`.
DATABASE_URL=postgresql+asyncpg://infraops:infraops@postgres:5432/infraops
POSTGRES_USER=infraops
POSTGRES_PASSWORD=infraops
POSTGRES_DB=infraops

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Infrastructure mode ─────────────────────────────────────────────────────
# mock = fully functional in-memory VMware/guest simulation (no vCenter needed)
# real = talk to actual vCenter via the pyvmomi-based adapter
INFRASTRUCTURE_MODE=mock

# ── Authentication ──────────────────────────────────────────────────────────
AUTH_MODE=local                              # local (dev) | ldap | oidc (future)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=720
RATE_LIMIT_LOGIN_PER_MINUTE=10
COOKIE_SECURE=false                          # set true when serving over HTTPS

# ── Secrets provider ────────────────────────────────────────────────────────
# env   = development provider resolving secrets from environment variables
# vault = HashiCorp Vault KV v2 (production)
SECRETS_PROVIDER=env
VAULT_ADDR=https://vault.internal:8200
VAULT_TOKEN=
VAULT_KV_MOUNT=secret

# Development secret values (env provider). Format: SECRETS_<NAME>=value
SECRETS_VCSA_PROD_USERNAME=svc-infraops-vsphere
SECRETS_VCSA_PROD_PASSWORD=dev-only-not-a-real-password
SECRETS_GUEST_LOCAL_ADMIN_USERNAME=administrator
SECRETS_GUEST_LOCAL_ADMIN_PASSWORD=dev-only-not-a-real-password
SECRETS_DOMAIN_JOIN_USERNAME=svc-domain-join
SECRETS_DOMAIN_JOIN_PASSWORD=dev-only-not-a-real-password

# ── Guest automation defaults ───────────────────────────────────────────────
GUEST_DEFAULT_USERNAME=administrator

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2

# ── CORS (development frontend dev-server origin) ───────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Development seed administrator ──────────────────────────────────────────
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@example.internal
DEV_ADMIN_PASSWORD=ChangeMe_DevOnly!123

# ── Frontend build-time variables (used by the frontend container/dev server)
VITE_API_BASE=/api/v1
VITE_ENVIRONMENT_LABEL=DEV
