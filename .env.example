# InfraOps production configuration template.
# Copy to .env, set every required value, then restrict it: chmod 600 .env

# Application
ENVIRONMENT=production
SECRET_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL. URL-encode reserved characters in DATABASE_URL credentials.
POSTGRES_USER=infraops
POSTGRES_PASSWORD=
POSTGRES_DB=infraops
DATABASE_URL=postgresql+asyncpg://infraops:URL_ENCODED_PASSWORD@postgres:5432/infraops

# Redis is reachable only on the private Compose network.
REDIS_URL=redis://redis:6379/0

# Real integrations only in production.
INFRASTRUCTURE_MODE=real
# Optional CA bundle path inside backend/worker containers.
VCENTER_CA_FILE=
AUTH_MODE=local
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=720
RATE_LIMIT_LOGIN_PER_MINUTE=10
COOKIE_SECURE=true

# Secret values can come from environment variables or Vault KV v2.
SECRETS_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret

# Example convention only: a database reference of vcenter/username resolves
# from SECRETS_VCENTER_USERNAME when SECRETS_PROVIDER=env.
SECRETS_VCENTER_USERNAME=
SECRETS_VCENTER_PASSWORD=
SECRETS_GUEST_LOCAL_ADMIN_USERNAME=
SECRETS_GUEST_LOCAL_ADMIN_PASSWORD=
SECRETS_DOMAIN_JOIN_USERNAME=
SECRETS_DOMAIN_JOIN_PASSWORD=

WORKER_CONCURRENCY=2

# Leave empty for a same-origin reverse-proxy deployment. Otherwise list only
# the exact HTTPS browser origins, separated by commas.
CORS_ORIGINS=

# Used only when the database has no active administrator. Remove the password
# from .env after the first successful bootstrap and restart the services.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# The frontend is intentionally published on loopback for a host TLS reverse
# proxy. Change the bind address only if another firewall-protected design is used.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
VITE_API_BASE=/api/v1
VITE_ENVIRONMENT_LABEL=PROD
