# Rendered by the nginx image entrypoint (envsubst) into conf.d/default.conf.
# Only ${TRUSTED_PROXY_CIDR} is substituted; nginx $variables are untouched.

# Access logs never contain query strings (they may carry one-time tokens).
log_format infraops '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent"';

# True when the TCP peer is the trusted TLS reverse proxy in front of us.
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}

# Honour X-Forwarded-Proto only from the trusted proxy.
map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    "1:https" https;
    "1:http"  http;
    default   $scheme;
}

# Resolve the real client address from X-Forwarded-For only when the
# request arrives from the trusted reverse proxy. Everything else keeps
# the TCP peer address, so clients cannot spoof their IP.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80;
    server_name _;
    # Serves the application, or only a health check and a redirect to HTTPS
    # when a certificate is mounted (see 40-infraops-tls.sh).
    include /etc/nginx/infraops/http-mode.conf;
}
